X_OAUTH_CONSUMER_KEY=op://DevOps/X API Key/Consumer Key
X_OAUTH_CONSUMER_SECRET=op://DevOps/X API Key/Secret Key
X_BEARER_TOKEN=op://DevOps/X API Key/Bearer Token
X_API_DEBUG=1
MCP_HOST=127.0.0.1
MCP_PORT=8000
X_API_TOOL_ALLOWLIST=getUsersByUsername,getUsersMe,getUsersPosts,searchPostsRecent,createPosts,getPostsById,getUsersBookmarks,getUsersBookmarkFolders,getUsersBookmarksByFolderId,createUsersBookmark,deleteUsersBookmark
X_OAUTH_CALLBACK_HOST=127.0.0.1
X_OAUTH_CALLBACK_PORT=8976
X_OAUTH_CALLBACK_PATH=/oauth/callback
X_OAUTH_CALLBACK_TIMEOUT=300
